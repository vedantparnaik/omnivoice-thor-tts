# Python environment
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Hugging Face model cache (re-downloaded on first run)
hf_cache/

# Large build artifacts — regenerated by scripts/ (see README).
# GitHub rejects >100 MB files; engines/weights are multi-GB.
artifacts/*
# ...but keep the small, review-useful reports:
!artifacts/.gitkeep
!artifacts/*.json

# Native build output
cpp/*.o
cpp/vocoder_trt

# Runtime / logs / pids
*.log
*.pid
